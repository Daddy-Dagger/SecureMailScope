{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionSchema",
  "description": "Schema for an email protocol session with metadata-only plaintext reconstruction and transport-upgrade state.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "protocol": {
      "type": "string",
      "enum": ["SMTP", "IMAP", "POP3"],
      "description": "Application layer email protocol"
    },
    "client_ip": {
      "type": "string",
      "description": "Client IPv4 or IPv6 address"
    },
    "client_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Client source port"
    },
    "server_ip": {
      "type": "string",
      "description": "Server IPv4 or IPv6 address"
    },
    "server_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Server destination port"
    },
    "packet_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of packets in this session"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Session start timestamp (ISO 8601)"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Session end timestamp (ISO 8601)"
    },
    "application_events": {
      "type": "array",
      "description": "Ordered, normalized protocol events relevant to STARTTLS/STLS state; arbitrary message bodies and credentials are not retained.",
      "items": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": ["CLIENT_TO_SERVER", "SERVER_TO_CLIENT"]
          },
          "kind": {
            "type": "string",
            "enum": ["GREETING", "COMMAND", "CAPABILITY", "RESPONSE", "TLS_START"]
          },
          "name": {
            "type": "string",
            "description": "Normalized command, response code, capability, or TLS marker"
          },
          "frame_number": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "tag": {
            "type": "string",
            "description": "IMAP command tag when applicable"
          }
        },
        "required": ["direction", "kind", "name", "frame_number", "timestamp"],
        "additionalProperties": false
      }
    },
    "transport_security": {
      "type": "object",
      "description": "Observed plaintext-to-TLS transition state. This does not include deep TLS handshake analysis.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["PLAINTEXT", "STARTTLS", "IMPLICIT_TLS", "UNKNOWN"]
        },
        "upgrade_status": {
          "type": "string",
          "enum": ["NOT_APPLICABLE", "NOT_ADVERTISED", "ADVERTISED_NOT_REQUESTED", "REQUESTED", "ACCEPTED", "UPGRADED", "FAILED", "INCOMPLETE", "UNKNOWN"],
          "description": "Common STARTTLS status, including POP3 STLS upgrades"
        },
        "advertised": {"type": "boolean"},
        "requested": {"type": "boolean"},
        "accepted": {"type": "boolean"},
        "tls_detected": {"type": "boolean"},
        "upgrade_command": {
          "type": ["string", "null"],
          "enum": ["STARTTLS", "STLS", null],
          "description": "Protocol command used for an explicit upgrade; null for implicit TLS"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "advertised_frame": {"type": "integer", "minimum": 1},
            "request_frame": {"type": "integer", "minimum": 1},
            "accept_frame": {"type": "integer", "minimum": 1},
            "tls_start_frame": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "required": ["mode", "upgrade_status", "advertised", "requested", "accepted", "tls_detected", "upgrade_command", "evidence"],
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "description": "Observable TLS handshake metadata. Certificate and security classification fields are intentionally excluded.",
      "properties": {
        "detected": {"type": "boolean"},
        "handshake_status": {
          "type": "string",
          "enum": ["NOT_APPLICABLE", "DETECTED", "INCOMPLETE", "COMPLETE", "FAILED", "UNKNOWN"]
        },
        "offered_versions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "offered_groups": {
          "type": "array",
          "description": "Unique named groups advertised through ClientHello supported-groups or key-share extensions.",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^0x[0-9a-f]{4}$"},
              "name": {"type": ["string", "null"]}
            },
            "required": ["id", "name"],
            "additionalProperties": false
          }
        },
        "version": {"type": ["string", "null"]},
        "cipher_suite": {
          "type": ["object", "null"],
          "properties": {
            "id": {"type": "string", "pattern": "^0x[0-9a-f]{4}$"},
            "name": {"type": ["string", "null"]}
          },
          "required": ["id", "name"],
          "additionalProperties": false
        },
        "key_exchange": {
          "type": ["object", "null"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["ECDHE", "DHE", "RSA", "PSK", "UNKNOWN"]
            },
            "group": {
              "type": ["object", "null"],
              "properties": {
                "id": {"type": "string", "pattern": "^0x[0-9a-f]{4}$"},
                "name": {"type": ["string", "null"]}
              },
              "required": ["id", "name"],
              "additionalProperties": false
            }
          },
          "required": ["method", "group"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "client_hello_frame": {"type": "integer", "minimum": 1},
            "server_hello_frame": {"type": "integer", "minimum": 1},
            "selected_version_frame": {"type": "integer", "minimum": 1},
            "selected_cipher_frame": {"type": "integer", "minimum": 1},
            "key_exchange_frame": {"type": "integer", "minimum": 1},
            "handshake_complete_frame": {"type": "integer", "minimum": 1},
            "alert_frame": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "required": ["detected", "handshake_status", "offered_versions", "offered_groups", "version", "cipher_suite", "key_exchange", "evidence"],
      "additionalProperties": false
    }
  },
  "required": [
    "session_id",
    "protocol",
    "client_ip",
    "client_port",
    "server_ip",
    "server_port",
    "packet_count",
    "start_time",
    "end_time"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "session_id": "smtp-001",
      "protocol": "SMTP",
      "client_ip": "192.168.1.10",
      "client_port": 51544,
      "server_ip": "192.168.1.20",
      "server_port": 25,
      "packet_count": 63,
      "start_time": "2026-09-02T10:10:10Z",
      "end_time": "2026-09-02T10:10:15Z",
      "application_events": [],
      "transport_security": {
        "mode": "PLAINTEXT",
        "upgrade_status": "UNKNOWN",
        "advertised": false,
        "requested": false,
        "accepted": false,
        "tls_detected": false,
        "upgrade_command": "STARTTLS",
        "evidence": {}
      },
      "tls": {
        "detected": false,
        "handshake_status": "NOT_APPLICABLE",
        "offered_versions": [],
        "offered_groups": [],
        "version": null,
        "cipher_suite": null,
        "key_exchange": null,
        "evidence": {}
      }
    }
  ]
}
